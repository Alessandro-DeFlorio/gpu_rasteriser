@PACKAGE_INIT@

# Whether this package was built with the CUDA backend (TETVOX_ENABLE_CUDA, ADR 0008). Set before
# the language check below, so a consumer can read it from a QUIET find_package and enable CUDA.
set(tetvox_CUDA_ENABLED @TETVOX_CUDA_ENABLED@)

# With CUDA, tetvox is a static library with CUDA code. Linking it needs the CUDA runtime, which
# CMake adds (static or shared, per CMAKE_CUDA_RUNTIME_LIBRARY) only in projects that enable CUDA.
get_property(_tetvox_languages GLOBAL PROPERTY ENABLED_LANGUAGES)
if(tetvox_CUDA_ENABLED AND NOT "CUDA" IN_LIST _tetvox_languages)
  set(tetvox_FOUND FALSE)
  string(CONCAT tetvox_NOT_FOUND_MESSAGE
         "this tetvox was built with CUDA and needs the CUDA language: call project(... CUDA) or "
         "enable_language(CUDA) before find_package(tetvox).")
  return()
endif()

include("${CMAKE_CURRENT_LIST_DIR}/tetvoxTargets.cmake")
check_required_components(tetvox)
